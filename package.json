{
  "name": "@ririnto/lean-plugin",
  "version": "0.1.0",
  "description": "Run Lean diagnostics and package proof checks over MCP stdio.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ririnto/lean-plugin.git"
  },
  "bin": {
    "lean-plugin": "dist/server.js"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p src/tsconfig.build.json",
    "check": "run-p check:*",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:test": "node --test scripts/test-consumer.mjs",
    "check:typescript": "tsc",
    "check:ultracite": "ultracite check",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "fix:ultracite": "ultracite fix",
    "prepack": "pnpm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "@tsconfig/node-lts": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.21.0"
}
