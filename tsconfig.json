{
  "extends": "@tsconfig/node-lts/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "types": ["node"]
  },
  "include": [
    "**/*.mjs",
    "**/.*/**/*.mjs",
    "**/.*.mjs",
    "**/.*/**/.*.mjs",
    "**/*.ts",
    "**/.*/**/*.ts",
    "**/.*.ts",
    "**/.*/**/.*.ts"
  ],
  "exclude": ["dist"]
}
